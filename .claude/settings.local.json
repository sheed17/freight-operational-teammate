{
  "autoUpdatesChannel": "stable",
  "disableBypassPermissionsMode": "disable",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "MAX_MCP_OUTPUT_TOKENS": "50000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/sammyfammy/.claude/neyma/hooks/pre_bash_guard.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "/Users/sammyfammy/.claude/neyma/hooks/pre_mcp_guard.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__.*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/Users/sammyfammy/.claude/neyma/hooks/session_start.py",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/python scripts/check_env.py *)",
      "Bash(git branch --show-current)",
      "Bash(git diff *)",
      "Bash(git grep *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(aws *)",
      "Bash(az *)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(docker *)",
      "Bash(docker push *)",
      "Bash(docker)",
      "Bash(gcloud *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(git branch -D *)",
      "Bash(git clean *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(kubectl *)",
      "Bash(rm -rf *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(chmod -R 777 *)",
      "Bash(gh auth token *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(git clean)",
      "Bash(git config --global *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git restore *)",
      "Bash(git restore)",
      "Bash(git stash *)",
      "Bash(git stash)",
      "Bash(security *)",
      "Bash(sudo *)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.staging)",
      "Edit(./.env.test)",
      "Edit(./.mcp.json)",
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/**)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)",
      "Write(./.claude/settings.local.json)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./.env.*.local)",
      "Write(./.env.development)",
      "Write(./.env.local)",
      "Write(./.env.production)",
      "Write(./.env.staging)",
      "Write(./.env.test)",
      "Write(./.mcp.json)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      ".venv/bin/python scripts/finalize_status.py"
    ],
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        ".env",
        "~/.aws",
        "~/.azure",
        "~/.config/gcloud",
        "~/.docker",
        "~/.kube",
        "~/.ssh"
      ]
    },
    "network": {
      "allowedDomains": [
        "127.0.0.1",
        "api.anthropic.com",
        "api.github.com",
        "api.githubcopilot.com",
        "code.claude.com",
        "docs.anthropic.com",
        "docs.python.org",
        "files.pythonhosted.org",
        "github.com",
        "localhost",
        "mcp.notion.com",
        "mcp.slack.com",
        "objects.githubusercontent.com",
        "playwright.dev",
        "pypi.org",
        "raw.githubusercontent.com",
        "registry.npmjs.org"
      ]
    }
  }
}
